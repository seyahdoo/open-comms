APP_BIND_ADDR=0.0.0.0:8080
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=open_comms
RUST_LOG=info,open_comms_server=debug
WEB_DIST_DIR=apps/web/dist
MEDIA_BIND_ADDR=0.0.0.0:3478
# Browsers ignore loopback ICE candidates. Use a non-loopback IP that clients can reach.
MEDIA_ADVERTISE_ADDR=192.168.1.10:3478

# Dev-only self-signed HTTPS proxy: docker compose --profile https up
# Include every hostname/IP you will browse to; replace the example LAN IP.
HTTPS_HOSTS=localhost,192.168.1.10
HTTPS_PORT=8443
